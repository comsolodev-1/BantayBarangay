<%@ Master Language="VB" AutoEventWireup="false" CodeFile="Public.master.vb" Inherits="PublicMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bantay Barangay</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:Table runat="server" SkinID="Page" role="presentation">
            <asp:TableRow><asp:TableCell BackColor="#1A3D28" ForeColor="White">
                    <asp:Image runat="server" ImageUrl="~/Content/dilg-logo.png" AlternateText="DILG" Height="48px" ImageAlign="Middle" />
                    <strong>Bantay Barangay - DILG Talisay, Camarines Norte</strong>
                    <nav aria-label="Public navigation"><asp:PlaceHolder ID="litNav" runat="server" /></nav>
            </asp:TableCell></asp:TableRow>
            <asp:TableRow><asp:TableCell>
                <main><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
            </asp:TableCell></asp:TableRow>
        </asp:Table>
    </form>
</body>
</html>
