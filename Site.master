<%@ Master Language="VB" AutoEventWireup="false" CodeFile="Site.master.vb" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bantay Barangay</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:Table runat="server" SkinID="Page" role="presentation">
            <asp:TableRow ID="mobileNavRow" runat="server" Visible="false" />
            <asp:TableRow ID="workspaceRow" runat="server">
                <asp:TableCell ID="navigationCell" runat="server" Width="215px" VerticalAlign="Top" BackColor="#1A3D28" ForeColor="White">
                    <asp:Image runat="server" ImageUrl="~/Content/dilg-logo.png" AlternateText="DILG" Height="64px" />
                    <p><strong>DILG Talisay</strong><br />Camarines Norte</p>
                    <p><b><asp:Literal ID="litName" runat="server" /></b><br /><asp:Literal ID="litRole" runat="server" /></p>
                    <nav aria-label="Staff navigation">
                        <asp:PlaceHolder ID="litMenu" runat="server" />
                        <asp:PlaceHolder ID="litSettings" runat="server" />
                        <asp:LinkButton ID="btnSignOut" runat="server" SkinID="SignOut" CausesValidation="false" OnClick="btnSignOut_Click">Sign Out</asp:LinkButton>
                    </nav>
                </asp:TableCell>
                <asp:TableCell VerticalAlign="Top">
                    <asp:Panel runat="server" BackColor="#1A5C38" ForeColor="White">
                        <b><asp:Literal ID="litTitle" runat="server" /></b> &nbsp; <asp:Literal ID="litToday" runat="server" />
                    </asp:Panel>
                    <main><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
                </asp:TableCell>
            </asp:TableRow>
        </asp:Table>
    </form>
</body>
</html>
